<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AiNiTA | CORE 6000</title>
    <style>
        body { background: #000 !important; color: #0f0 !important; font-family: 'Courier New', monospace; padding: 15px; margin: 0; }
        .header { border-left: 5px solid #f00; padding: 20px; margin-bottom: 20px; background: rgba(255,0,0,0.1); }
        .status { color: #0f0; text-shadow: 0 0 10px #0f0; font-size: 0.75rem; letter-spacing: 2px; }
        input { width: 100%; padding: 22px; background: #080808; border: 1px solid #333; color: #0f0; font-size: 1.4rem; outline: none; border-bottom: 3px solid #f00; box-sizing: border-box; }
        #results { margin-top: 25px; }
        .card { background: #0a0a0a; border: 1px solid #222; padding: 20px; margin-bottom: 20px; border-left: 6px solid #0f0; }
        .tag { color: #f00; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; margin-bottom: 10px; display: block; }
        .protocol { background: rgba(255,0,0,0.1); border: 1px dashed #f00; padding: 15px; margin-top: 15px; color: #ff9d9d; }
        h2 { color: #fff; margin: 0 0 10px 0; font-size: 1.5rem; }
    </style>
</head>
<body>

<div class="header">
    <div class="status">SYSTEM ONLINE // ARCHITECT MODE ACTIVE</div>
    <h1 style="color:#fff; margin:5px 0;">AiNiTA UNIVERZITET</h1>
</div>

<input type="text" id="search" placeholder="Kucaj (Pritisak, Lek, Psiho)..." oninput="runEngine()">

<div id="results"></div>

<script>
// --- INTEGRISANA BAZA SA MNOGO PODATAKA ---
const KORPUS = [
    { n: "Visok Pritisak", c: "HITNO", o: "Preko 180/110 mmHg. Opasnost od udara.", u: "Mirovanje, polusedeći stav, merenje na 15 min.", s: "Tvoj mir je ključ. Arhitekta ne paniči." },
    { n: "Bromazepam", c: "LEK", o: "Sedativ. Smiruje, ali opušta mišiće.", u: "Prati stabilnost. Rizik od pada kuka je ogroman.", s: "Bezbednost pre svega. Ako je pospan, stopiraj dozu." },
    { n: "Mračna Psihologija - Tišina", c: "STRATEGIJA", o: "Tišina kao alat pritiska na sagovornika.", u: "Gledaj u oči, ćuti dok oni ne progovore.", s: "Vladi tišinom. Pusti ih da se sami otkriju." },
    { n: "Madopar", c: "LEK", o: "Za Parkinson. Ključan za pokret.", u: "Stroga satnica. Proteini blokiraju lek.", s: "15 min kašnjenja pravi haos. Budi precizan." },
    { n: "Aikido - Hara", c: "BORILAČKE", o: "Stabilnost iz stomaka.", u: "Tvojih 97kg je neprobojno ako si u niskom stavu.", s: "Rotiraj iz kuka, ne vuci leđima." },
    { n: "Aspiraciona Pneumonija", c: "NEGA", o: "Gušenje hranom/tečnošću.", u: "Uspravi na 90 stepeni. Aspirator spreman.", s: "Krkljanje je alarm. Odmah uspravi pacijenta." },
    { n: "Lasix", c: "LEK", o: "Izbacuje vodu, obara pritisak.", u: "Prati diurezu i grčeve (pad kalijuma).", s: "Previše vode napolje vodi u konfuziju." },
    { n: "Haldol", c: "LEK", o: "Antipsihotik za jaku agresiju.", u: "Prati ukočenost i gutanje.", s: "Snažan lek. Samo uz strogi nadzor." },
    { n: "Saturacija", c: "HITNO", o: "Kiseonik u krvi. Alarm ispod 92%.", u: "Uspravi pacijenta, proveri prohodnost puteva.", s: "Hladni prsti daju lažne rezultate." }
];

function runEngine() {
    const query = document.getElementById('search').value.toLowerCase();
    const output = document.getElementById('results');
    output.innerHTML = "";
    if(query.length < 2) return;

    const matches = KORPUS.filter(i => 
        i.n.toLowerCase().includes(query) || i.c.toLowerCase().includes(query) || i.o.toLowerCase().includes(query)
    );

    matches.forEach(m => {
        output.innerHTML += `
            <div class="card">
                <span class="tag">${m.c}</span>
                <h2>${m.n}</h2>
                <p><strong>OPIS:</strong> ${m.o}</p>
                <p style="color:#0f0;"><strong>PROTOKOL:</strong> ${m.u}</p>
                <div class="protocol"><strong>SAVET 6000:</strong><br>${m.s}</div>
            </div>`;
    });
}
</script>
</body>
</html>
