<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AiNiTA CORE | 6000</title>
    <style>
        body { background: #050505; color: #d0d0d0; font-family: 'Courier New', monospace; padding: 15px; text-transform: uppercase; overflow-x: hidden; }
        .bunker-header { border-bottom: 3px solid #ff0000; padding-bottom: 15px; margin-bottom: 20px; }
        .status { color: #00ff00; font-size: 0.7rem; letter-spacing: 2px; }
        input { width: 100%; padding: 18px; background: #111; border: 2px solid #444; color: #00ff00; font-size: 1.2rem; outline: none; box-sizing: border-box; -webkit-appearance: none; }
        input:focus { border-color: #ff0000; box-shadow: 0 0 10px #ff0000; }
        #result { margin-top: 20px; padding: 20px; background: #0f0f0f; border-left: 5px solid #00ff00; display: none; }
        .advice-box { background: #1a0000; border: 1px dashed #ff0000; padding: 15px; margin-top: 15px; color: #ff9999; font-size: 0.9rem; line-height: 1.4; }
        .red-alert { color: #ff0000; border: 1px solid #ff0000; padding: 12px; margin-top: 25px; text-align: center; font-size: 0.8rem; letter-spacing: 1px; }
        .footer-lines { margin-top: 40px; font-size: 0.7rem; color: #444; border-top: 1px solid #222; padding-top: 10px; text-align: center; font-style: italic; }
    </style>
</head>
<body>

<div class="bunker-header">
    <div class="status">SYSTEM ACTIVE // 6000 MILES AHEAD</div>
    <h1 style="margin:5px 0 0 0; font-size: 1.6rem; color: #fff;">AiNiTA CORE</h1>
</div>

<input type="text" id="search" placeholder="KUCАJ: VRT, BROM, ŠIZ, PAR..." oninput="searchEngine()">

<div id="result"></div>

<div class="red-alert">
    ALARM: PRITISAK > 180/110 | SAT < 90%
</div>

<div class="footer-lines">
    "ZAPAMTI OVO, ZABORAVI SE / NE SKLANJAM SE, ZAOBIĐI ME"
</div>

<script>
    // SVE JE SPAKOVANO OVDE - NEMA VIŠE EKSTERNIH FAJLOVA
    const DATA = [
        {naziv: "Vrtoglavica", opis: "Vertigo. Odmah proveri pritisak i šećer.", savet: "Smiri korisnika, neka sedne pre merenja. Može biti od naglog ustajanja ili lekova."},
        {naziv: "Bromazepam", opis: "Anksiolitik. Za smirenje i opuštanje mišića.", savet: "Pazi na pospanost, usporeno disanje i visok rizik od pada u smeni."},
        {naziv: "Alchajmer", opis: "Kognitivni deficit i dezorijentacija.", savet: "Validacija bez ispravljanja. Ne raspravljaj se, samo ga nežno preusmeri na drugu temu."},
        {naziv: "Šizofrenija", opis: "Halucinacije i deluzije (paranoja).", savet: "Asimetrična dominacija. Stoj pod uglom od 45 stepeni, nikad direktno oči u oči."},
        {naziv: "Parkinson", opis: "Rigor (ukočenost) i Tremor (drhtanje).", savet: "Auditivni ritam. Koristi jasan ritmički glas 1-2-1-2 da probiješ 'freezing' blokadu."},
        {naziv: "Demencija", opis: "Sundowning (nemir pred mrak).", savet: "Senzorna deprivacija. Smanji svetlo i buku, pričaj o stvarima iz njihove daleke mladosti."},
        {naziv: "Gušenje", opis: "Dispneja. Otežano disanje.", savet: "Podigni uzglavlje kreveta, proveri saturaciju, otvori prozor za svež vazduh."},
        {naziv: "Mučnina", opis: "Nausea. Kod starijih može biti prikriveni predznak infarkta.", savet: "Proveri hladan znoj, bledo lice i bol u grudima/vilici odmah."},
        {naziv: "Saturacija", opis: "Nivo kiseonika u krvi.", savet: "Ispod 92% je kritično. Proveri položaj tela i disajne puteve. ALARM ako pada dalje."},
        {naziv: "Hipertenzija", opis: "Visok pritisak preko 140/90.", savet: "Rizik od šloga. Obezbedi mir i tišinu korisniku dok terapija ne odradi svoje."},
        {naziv: "Lasix", opis: "Diuretik. Izbacivanje tečnosti iz organizma.", savet: "Pazi na dehidrataciju, pad pritiska i veoma česte odlaske u toalet."},
        {naziv: "Enalapril", opis: "Lek za kontrolu visokog pritiska.", savet: "Obavezno proveri pritisak sat vremena nakon što korisnik popije lek."},
        {naziv: "Paranoja", opis: "Umišljen strah da ga neko krade ili truje.", savet: "Ne ubeđuj ga da nije u pravu (to pojačava bes). Reci: 'Razumem da se osećaš nesigurno'."}
    ];

    function searchEngine() {
        let query = document.getElementById('search').value.toLowerCase();
        let res = document.getElementById('result');
        
        if (query.length < 2) { res.style.display = 'none'; return; }

        // Pretraga kroz objedinjenu bazu
        let match = DATA.find(item => item.naziv.toLowerCase().includes(query));

        if (match) {
            res.style.display = 'block';
            res.innerHTML = `
                <h2 style="color:#00ff00; margin-top:0; font-size:1.4rem;">${match.naziv}</h2>
                <p style="margin-bottom:10px;"><strong>ANALIZA:</strong> ${match.opis}</p>
                <div class="advice-box"><strong>STRATEGIJA ZA RAD:</strong><br>${match.savet}</div>
            `;
        } else {
            res.style.display = 'none';
        }
    }
</script>

</body>
</html>
