<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AiNiTA | BUNKER 6000</title>
    <style>
        body { background: #000; color: #aaa; font-family: 'Courier New', monospace; padding: 15px; margin: 0; overflow-x: hidden; }
        .header { border-left: 4px solid #f00; padding: 15px; margin-bottom: 20px; background: rgba(255,0,0,0.05); }
        .status { color: #0f0; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; animation: blink 2s infinite; }
        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
        input { width: 100%; padding: 20px; background: #0a0a0a; border: 1px solid #333; color: #0f0; font-size: 1.2rem; outline: none; border-bottom: 3px solid #f00; box-sizing: border-box; }
        #results { margin-top: 20px; }
        .card { background: #050505; border: 1px solid #1a1a1a; padding: 15px; margin-bottom: 15px; border-left: 4px solid #0f0; }
        .tag { color: #f00; font-size: 0.65rem; font-weight: bold; text-transform: uppercase; display: block; margin-bottom: 5px; }
        h2 { color: #fff; margin: 0 0 10px 0; font-size: 1.3rem; }
        .prot { background: rgba(255,0,0,0.1); border: 1px dashed #400; padding: 10px; margin-top: 10px; color: #ff9d9d; font-size: 0.9rem; }
        strong { color: #0f0; }
    </style>
</head>
<body>

<div class="header">
    <div class="status">● ARCHITECT MODE ACTIVE // NO LIMITS</div>
    <h1 style="color:#fff; margin:5px 0; font-size: 1.6rem;">AiNiTA UNIVERZITET</h1>
</div>

<input type="text" id="search" placeholder="TRAŽI (LEK, DIJAGNOZA, PSIHO)..." oninput="run()">

<div id="results"></div>

<script>
const KORPUS = [
    // --- MEDICINA & HITNO ---
    { n: "Visok Pritisak", c: "HITNO", o: "Iznad 180/110 mmHg. Rizik od sloga.", u: "Polusedeći položaj, mir, kontrola na 15min.", s: "Tvoj mir je lek. Ne dopusti da pacijent oseti tvoju napetost." },
    { n: "Nizak Pritisak", c: "HITNO", o: "Iznad 90/60 mmHg. Vrtoglavica, nesvestica.", u: "Podigni noge (Trendelenburg), tečnost.", s: "Proveri da li je pacijent popio Lasix ili diuretik pre padanja." },
    { n: "Saturacija (SpO2)", c: "NEGA", o: "Kiseonik u krvi. Kritično ispod 92%.", u: "Uspravi pacijenta, proveri prohodnost disajnih puteva.", s: "Hladni prsti daju lažan rezultat. Ugrej ruku pre merenja." },
    { n: "Aspiracija", c: "ALARM", o: "Gušenje hranom/tečnošću. Uzrok pneumonije.", u: "Uspravi na 90 stepeni. Aspirator spreman.", s: "Ako krklja dok jede, odmah stani. Preventiva je 6000 milja ispred lečenja." },
    { n: "Hipoglikemija", c: "HITNO", o: "Šećer ispod 3.9 mmol/L. Hladan znoj, agresija.", u: "15g šećera (med, sok), provera za 15min.", s: "Ako je bez svesti, ništa u usta! Zovi hitnu odmah." },

    // --- FARMAKOLOGIJA (MESO) ---
    { n: "Bromazepam", c: "LEK", o: "Sedativ. Smiruje, ali opušta mišiće.", u: "Rizik od pada kuka kod starijih.", s: "Ne daj ako pacijent već jedva drži oči otvorene." },
    { n: "Madopar", c: "LEK", o: "Za Parkinson. Ključan za hod.", u: "Davati van obroka (proteini ga blokiraju).", s: "Stroga satnica. 15 minuta kašnjenja pravi haos u hodu." },
    { n: "Lasix", c: "LEK", o: "Diuretik. Izbacuje vodu, obara pritisak.", u: "Prati mokrenje i grčeve (pad kalijuma).", s: "Previše Lasixa vodi u konfuziju i pad pritiska." },
    { n: "Haldol", c: "LEK", o: "Antipsihotik. Za tešku agitaciju.", u: "Prati ukočenost mišića i gutanje.", s: "Ovaj lek 'zaključava' pacijenta. Budi oprezan sa dozom." },
    { n: "Enalapril", c: "LEK", o: "Za pritisak. Dugotrajno dejstvo.", u: "Može izazvati suvi kašalj.", s: "Ako pacijent stalno kašlje, a pluća čista, proveri ovaj lek." },

    // --- PSIHOLOGIJA & BIOMEHANIKA ---
    { n: "Mračna Psihologija", c: "STRATEGIJA", o: "Upotreba tišine i pogleda za dominaciju.", u: "Gledaj u oči, ćuti dok oni ne progovore.", s: "Ko prvi progovori nakon tvoje tišine, izgubio je poziciju moći." },
    { n: "Hara (Stabilnost)", c: "AIKIDO", o: "Centar mase u stomaku.", u: "Kod tvojih 97kg, niska baza je neprobojna.", s: "Rotiraj iz kuka, ne vuci rukama. Čuvaj kičmu." },
    { n: "Transfer (Judo)", c: "NEGA", o: "Korišćenje mase pacijenta za podizanje.", u: "Pusti pacijenta da se nagne napred pre dizanja.", s: "Ti si Arhitekta pokreta. Snaga je u poluzi, ne u mišiću." },
    { n: "Gaslighting", c: "ODBRANA", o: "Kad kolege pokušaju da te ubede da si pogrešio.", u: "Drži se zapisanih činjenica (protokola).", s: "Samo papir i tvoja smirenost te štite od manipulacije." }
];

function run() {
    const q = document.getElementById('search').value.toLowerCase();
    const res = document.getElementById('results');
    res.innerHTML = "";
    if(q.length < 2) return;

    KORPUS.filter(i => i.n.toLowerCase().includes(q) || i.c.toLowerCase().includes(q) || i.o.toLowerCase().includes(q))
    .forEach(m => {
        res.innerHTML += `
            <div class="card">
                <span class="tag">${m.c}</span>
                <h2>${m.n}</h2>
                <p>${m.o}</p>
                <p><strong>PROTOKOL:</strong> ${m.u}</p>
                <div class="prot"><strong>SAVET 6000:</strong> ${m.s}</div>
            </div>`;
    });
}
</script>
</body>
</html>
