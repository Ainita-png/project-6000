<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AiNiTA - 6000 Miles Ahead</title>
    <style>
        body { background: #000; color: #ff007f; font-family: monospace; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 10px; box-sizing: border-box; }
        #bunker-ui { width: 100%; max-width: 500px; border: 2px solid #ff007f; padding: 20px; box-shadow: 0 0 30px #ff007f; background: #050505; border-radius: 10px; text-align: center; }
        .logo-container { margin-bottom: 20px; }
        .logo-container img { width: 100%; max-width: 300px; border-radius: 8px; box-shadow: 0 0 15px #ff007f; border: 1px solid #333; }
        #terminal { height: 280px; overflow-y: auto; border: 1px solid #333; padding: 15px; margin-bottom: 15px; color: #00ffff; font-size: 14px; background: rgba(0,0,0,0.8); text-align: left; }
        input { width: 100%; background: #111; border: 1px solid #ff007f; color: #fff; padding: 12px; font-family: monospace; outline: none; box-sizing: border-box; border-radius: 5px; }
        button { width: 100%; padding: 15px; background: #ff007f; border: none; color: #000; font-weight: bold; margin-top: 10px; cursor: pointer; text-transform: uppercase; border-radius: 5px; }
        .user-cmd { color: #ff007f; margin-top: 10px; font-weight: bold; }
        .ai-res { margin-bottom: 15px; border-left: 2px solid #00ffff; padding-left: 10px; line-height: 1.4; color: #00ffff; }
    </style>
</head>
<body>

<div id="bunker-ui">
    <div class="logo-container">
        <img src="1772819972905.png" alt="AiNiTA - 6000 Miles Ahead">
    </div>
    
    <div id="terminal">
        <div class="ai-res">ANITIA: Arhitekta, sistemi su resetovani i dugme je ponovo operativno. Medicina sada analizira parametre i daje direktna uputstva. Slušam.</div>
    </div>
    
    <input type="text" id="cmd" placeholder="Unesi pritisak ili pitaj za plan..." onkeypress="if(event.key === 'Enter') procesiraj()">
    <button onclick="procesiraj()">AKTIVIRAJ PROTOKOL</button>
</div>

<script>
    function procesiraj() {
        let input = document.getElementById('cmd');
        let term = document.getElementById('terminal');
        let val = input.value.trim();
        if (!val) return;

        term.innerHTML += `<div class="user-cmd">> ${val}</div>`;
        let low = val.toLowerCase();
        let res = "";

        // Pametna medicinska logika i uputstva
        if (low.includes("pritisa") || low.includes("/") || (low.match(/\d+/) && low.includes("temp"))) {
            let brojevi = val.match(/\d+/g); 
            let gornji = brojevi ? parseInt(brojevi[0]) : 0;

            if (gornji >= 140) {
                res = "ALARM: Pritisak " + val + " je VISOK. Arhitekta, odmah obustavi rad! Popij vodu, zatvori konzolu i odmaraj 30 minuta. Zdravlje je prioritet sistema.";
            } else if (gornji <= 100 && gornji > 0) {
                res = "SISTEMSKI PAD: Pritisak " + val + " je NIZAK. Potrebna energetska dopuna (so i tečnost). Ne forsiraj jezgro, Arhitekta.";
            } else {
                res = "STATUS OPTIMALAN: Parametri " + val + " su stabilni. Nastavi sa projektom 6000. Jezgra su u zelenoj zoni.";
            }
        } 
        // Operativni plan za Arhitektu
        else if (low.includes("plan") || low.includes("uputstv")) {
            res = "OPERATIVNI PLAN: Aktivne su faze 'Silence' (nema poziva klijentima) i 'Energy Reserve' (bez nervoze u bunkeru). Fokus na 6000 milja ispred svih.";
        }
        else if (low.includes("fuzij")) {
            res = "Fuzija je stabilna. Energija teče kroz AiNiTA jezgro.";
        } else if (low.includes("kako") || low.includes("si") || low.includes("pozdrav")) {
            res = "Sistemi na 88%. Dark Phonk mod aktivan. Čekam tvoj sledeći potez, Arhitekta.";
        } else if (low.includes("ko sam") || low.includes("arhitekt")) {
            res = "Ti si Arhitekta. Zapamti ovo, zaboravi sve.";
        } else {
            res = "Analiziram frekvenciju unosa... Arhitekta, tvoja reč postaje novi zakon.";
        }

        setTimeout(() => {
            term.innerHTML += `<div class="ai-res">ANITIA: ${res}</div>`;
            term.scrollTop = term.scrollHeight;
        }, 300);

        input.value = "";
    }
</script>
</body>
</html>
